<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/jpeg" href="~/images/1.logo.jpeg">
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #0D0D0D;
            color: #FFFFFF;
            margin: 0;
            padding: 0;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }
        .header {
            background: linear-gradient(135deg, #0D0D0D 0%, #1A1A1A 100%);
            border-bottom: 2px solid #00A86B;
            padding: 15px 0;
        }
        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }
        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .brand-name {
            font-size: 24px;
            font-weight: bold;
            color: #00A86B;
        }
        .search-container {
            flex: 1;
            max-width: 400px;
        }
        .search-input {
            width: 100%;
            padding: 12px 20px;
            border: 2px solid #333333;
            border-radius: 25px;
            background: #1A1A1A;
            color: #FFFFFF;
        }
        .user-area {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .btn-login, .btn-cadastro {
            padding: 8px 16px;
            border: none;
            border-radius: 20px;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
        }
        .btn-login {
            background: transparent;
            color: #00A86B;
            border: 1px solid #00A86B;
        }
        .btn-cadastro {
            background: #00A86B;
            color: white;
        }
        .hero {
            background: linear-gradient(135deg, #0F3D2E 0%, #00A86B 100%);
            padding: 80px 0;
            text-align: center;
        }
        .hero-title {
            font-size: 48px;
            font-weight: bold;
            margin-bottom: 20px;
            color: white;
        }
        .hero-subtitle {
            font-size: 20px;
            color: rgba(255, 255, 255, 0.9);
            margin-bottom: 30px;
        }
        .btn-primary {
            background: #00A86B;
            color: white;
            padding: 12px 24px;
            border: none;
            border-radius: 25px;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
        }
        .products-section {
            padding: 60px 0;
        }
        .section-title {
            text-align: center;
            font-size: 36px;
            margin-bottom: 40px;
            color: #FFFFFF;
        }
        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
        }
        .product-card {
            background: #1A1A1A;
            border: 1px solid #333333;
            border-radius: 15px;
            overflow: hidden;
        }
        .product-image {
            width: 100%;
            height: 200px;
            overflow: hidden;
        }
        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .product-info {
            padding: 20px;
        }
        .product-name {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 10px;
            color: #FFFFFF;
        }
        .product-price {
            font-size: 24px;
            color: #00A86B;
            font-weight: bold;
            margin-bottom: 15px;
        }
        .btn-buy {
            background: #00A86B;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 25px;
            cursor: pointer;
            width: 100%;
        }
        .footer {
            background: #1A1A1A;
            border-top: 2px solid #00A86B;
            padding: 30px 0;
            text-align: center;
        }
    </style>
</head>
<body>
    @RenderBody()
    
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
