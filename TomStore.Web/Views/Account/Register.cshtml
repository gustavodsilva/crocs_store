@model TomStore.Application.DTOs.RegisterDTO
@{
    ViewData["Title"] = "Cadastro - Tom Store";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/jpeg" href="~/images/1.logo.jpeg">
    <link rel="stylesheet" href="~/css/cadastro.css">
</head>
<body>
    <div class="cadastro-container">
        <div class="cadastro-card">
            <div class="cadastro-header">
                <img src="~/images/1.logo.jpeg" alt="Tom Store Logo" class="cadastro-logo">
                <h1>Cadastrar na Tom Store</h1>
                <p>Crie sua conta para comprar e receber ofertas exclusivas</p>
            </div>
            
            <form asp-controller="Account" asp-action="Register" method="post" class="cadastro-form">
                <div asp-validation-summary="ModelOnly" class="error-message">
                    <span class="error-icon">⚠️</span>
                    <span class="error-text"></span>
                </div>
                
                <!-- Dados Pessoais -->
                <div class="form-section">
                    <h3>👤 Dados Pessoais</h3>
                    
                    <div class="form-group">
                        <label asp-for="Nome"></label>
                        <input asp-for="Nome" required>
                        <span asp-validation-for="Nome" class="field-error"></span>
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="Telefone"></label>
                        <input asp-for="Telefone" id="telefone" placeholder="(11) 99999-9999" required>
                        <small class="form-help">Será usado como seu login</small>
                        <span asp-validation-for="Telefone" class="field-error"></span>
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" type="email" placeholder="seu@email.com">
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="DataNascimento"></label>
                        <input asp-for="DataNascimento" type="date">
                        <span asp-validation-for="DataNascimento" class="field-error"></span>
                    </div>
                </div>
                
                <!-- Endereço -->
                <div class="form-section">
                    <h3>📍 Endereço</h3>
                    
                    <div class="form-group">
                        <label asp-for="Cep"></label>
                        <input asp-for="Cep" id="cep" placeholder="00000-000" maxlength="9" required>
                        <small class="form-help">Digite o CEP para preencher automaticamente</small>
                        <span asp-validation-for="Cep" class="field-error"></span>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Rua"></label>
                            <input asp-for="Rua" id="rua" readonly>
                            <span asp-validation-for="Rua" class="field-error"></span>
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="Numero"></label>
                            <input asp-for="Numero" required>
                            <span asp-validation-for="Numero" class="field-error"></span>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="Complemento"></label>
                        <input asp-for="Complemento" placeholder="Apto, casa, etc.">
                        <span asp-validation-for="Complemento" class="field-error"></span>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Bairro"></label>
                            <input asp-for="Bairro" id="bairro" readonly>
                            <span asp-validation-for="Bairro" class="field-error"></span>
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="Cidade"></label>
                            <input asp-for="Cidade" id="cidade" readonly>
                            <span asp-validation-for="Cidade" class="field-error"></span>
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="Estado"></label>
                            <input asp-for="Estado" id="estado" maxlength="2" readonly>
                            <span asp-validation-for="Estado" class="field-error"></span>
                        </div>
                    </div>
                </div>
                
                <!-- Senha -->
                <div class="form-section">
                    <h3>🔐 Senha</h3>
                    
                    <div class="form-group">
                        <label asp-for="Password"></label>
                        <input asp-for="Password" type="password" required>
                        <small class="form-help">Mínimo de 6 caracteres</small>
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="ConfirmPassword"></label>
                        <input asp-for="ConfirmPassword" type="password" required>
                        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                    </div>
                </div>
                
                <!-- Botões -->
                <div class="form-actions">
                    <a asp-controller="Account" asp-action="Login" class="btn-secondary">Já tenho conta</a>
                    <button type="submit" class="btn-primary">
                        <span class="btn-text">Cadastrar</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Loading Overlay -->
    <div id="loadingOverlay" class="loading-overlay" style="display: none;">
        <div class="loading-spinner"></div>
        <p>Processando...</p>
    </div>

    <script src="~/js/cadastro.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
