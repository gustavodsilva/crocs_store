/* ========================================
   ESTILOS - LOGIN TOM STORE (C# .NET)
   ======================================== */

/* Variáveis CSS */
:root {
    --primary-green: #00A86B;
    --primary-green-hover: #1ED760;
    --dark-green: #0F3D2E;
    --main-bg: #0D0D0D;
    --secondary-bg: #1A1A1A;
    --text-primary: #EAEAEA;
    --text-secondary: #B0B0B0;
    --border-radius: 8px;
    --border-radius-large: 12px;
    --transition: all 0.3s ease;
    --error-color: #ff4444;
    --success-color: #4CAF50;
}

/* Reset e Configurações Gerais */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(135deg, var(--main-bg) 0%, var(--secondary-bg) 100%);
    color: var(--text-primary);
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

/* Container Principal */
.login-container {
    width: 100%;
    max-width: 450px;
    padding: 20px;
}

/* Card de Login */
.login-card {
    background-color: var(--secondary-bg);
    border-radius: var(--border-radius-large);
    padding: 2.5rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    border: 1px solid var(--dark-green);
    position: relative;
    overflow: hidden;
}

.login-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--primary-green), var(--primary-green-hover));
}

/* Header do Login */
.login-header {
    text-align: center;
    margin-bottom: 2.5rem;
}

.login-logo {
    width: 80px;
    height: 80px;
    border-radius: var(--border-radius);
    margin-bottom: 1.5rem;
    box-shadow: 0 8px 25px rgba(0, 168, 107, 0.2);
    transition: var(--transition);
}

.login-logo:hover {
    transform: scale(1.05);
}

.login-header h1 {
    color: var(--primary-green);
    font-size: 2.2rem;
    margin-bottom: 0.5rem;
    font-weight: 700;
    text-shadow: 0 2px 10px rgba(0, 168, 107, 0.3);
}

.login-header p {
    color: var(--text-secondary);
    font-size: 1.1rem;
    font-style: italic;
}

/* Formulário de Login */
.login-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

/* Form Groups */
.form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.form-group label {
    color: var(--text-primary);
    font-weight: 600;
    font-size: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.form-group label::before {
    content: '';
    width: 4px;
    height: 4px;
    background-color: var(--primary-green);
    border-radius: 50%;
}

.form-group input {
    padding: 14px 18px;
    border: 2px solid var(--dark-green);
    border-radius: var(--border-radius);
    background-color: var(--main-bg);
    color: var(--text-primary);
    font-size: 1rem;
    transition: var(--transition);
    outline: none;
}

.form-group input:focus {
    border-color: var(--primary-green);
    box-shadow: 0 0 15px rgba(0, 168, 107, 0.3);
    transform: translateY(-2px);
}

.form-group input::placeholder {
    color: var(--text-secondary);
    opacity: 0.7;
}

.form-group input[type="checkbox"] {
    width: auto;
    margin-right: 0.5rem;
}

.form-group label[for="RememberMe"] {
    flex-direction: row;
    font-weight: 500;
    cursor: pointer;
}

.form-group label[for="RememberMe"]::before {
    display: none;
}

/* Botão de Login */
.btn-login {
    background: linear-gradient(135deg, var(--primary-green), var(--dark-green));
    color: white;
    border: none;
    padding: 16px 32px;
    border-radius: var(--border-radius);
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    transition: var(--transition);
    position: relative;
    overflow: hidden;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: 1rem;
}

.btn-login:hover {
    background: linear-gradient(135deg, var(--primary-green-hover), var(--primary-green));
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(0, 168, 107, 0.4);
}

.btn-login:active {
    transform: translateY(-1px);
}

.btn-login::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    transition: left 0.5s;
}

.btn-login:hover::before {
    left: 100%;
}

/* Mensagens de Erro */
.error-message {
    padding: 12px 16px;
    border-radius: var(--border-radius);
    margin-top: 1rem;
    display: flex;
    align-items: center;
    gap: 10px;
    animation: shake 0.5s;
    background-color: rgba(255, 68, 68, 0.1);
    border: 1px solid var(--error-color);
    color: var(--error-color);
}

.error-icon,
.success-icon {
    font-size: 1.2rem;
}

.error-text,
.success-text {
    flex: 1;
    font-weight: 500;
}

.field-error {
    color: var(--error-color);
    font-size: 0.8rem;
    margin-top: 0.5rem;
}

/* Login Footer */
.login-footer {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.login-links {
    text-align: center;
    margin-bottom: 2rem;
}

.link-cadastro {
    color: var(--primary-green);
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.link-cadastro:hover {
    color: var(--primary-green-hover);
    transform: translateY(-2px);
}

/* Loading Overlay */
.loading-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 9999;
}

.loading-spinner {
    width: 50px;
    height: 50px;
    border: 3px solid rgba(0, 168, 107, 0.3);
    border-top: 3px solid var(--primary-green);
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-bottom: 1rem;
}

.loading-overlay p {
    color: var(--text-primary);
    font-size: 1.1rem;
}

/* Animações */
@keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-10px); }
    75% { transform: translateX(10px); }
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Animação de entrada */
.login-card {
    animation: fadeIn 0.6s ease-out;
}

/* Validação de Campos */
.form-group input.error {
    border-color: var(--error-color);
    box-shadow: 0 0 10px rgba(255, 68, 68, 0.2);
}

.form-group input.success {
    border-color: var(--success-color);
    box-shadow: 0 0 10px rgba(76, 175, 80, 0.2);
}

/* Responsive Design */
@media (max-width: 768px) {
    .login-container {
        padding: 15px;
    }
    
    .login-card {
        padding: 2rem;
    }
    
    .login-header h1 {
        font-size: 2rem;
    }
    
    .login-logo {
        width: 70px;
        height: 70px;
    }
}

@media (max-width: 480px) {
    .login-container {
        padding: 10px;
    }
    
    .login-card {
        padding: 1.5rem;
    }
    
    .login-header h1 {
        font-size: 1.8rem;
    }
    
    .login-header p {
        font-size: 1rem;
    }
    
    .login-logo {
        width: 60px;
        height: 60px;
    }
    
    .btn-login {
        padding: 14px 28px;
        font-size: 1rem;
    }
}
